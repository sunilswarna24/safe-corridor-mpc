#!/bin/sh
# Drop agent co-author / Made-with trailers if a tool injects them.
MSG_FILE="$1"
[ -n "$MSG_FILE" ] || exit 0
tmp="${MSG_FILE}.strip"
grep -viE '^[[:space:]]*(Co-authored-by:[[:space:]]*Cursor[[:space:]]*<cursoragent@cursor\.com>|Made-with:[[:space:]]*Cursor)[[:space:]]*$' "$MSG_FILE" > "$tmp" || true
mv "$tmp" "$MSG_FILE"
